# Pabu 服务器配置
# 复制此文件为 .env 并根据需要修改

# ===== 服务器配置 =====
# 监听地址 (默认: 127.0.0.1，仅本地访问)
# 设置为 0.0.0.0 允许外部访问
SERVER_HOST=127.0.0.1

# 监听端口 (默认: 4001)
SERVER_PORT=4001

# ===== HTTPS 配置 (可选) =====
# 是否启用 HTTPS (true/false)
HTTPS_ENABLED=false

# SSL/TLS 证书路径 (HTTPS_ENABLED=true 时必填)
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=
HTTPS_CA_PATH=

# ===== 安全配置 =====
# 管理员密码文件路径 (默认: .admin-password.json)
ADMIN_PASSWORD_FILE=.admin-password.json

# 登录 Cookie 的 Secure 标记由服务端自动判断：请求经 https 到达才加，
# 纯 http 部署自动省略。无需修改本项，仅在需要覆盖自动判断时改动。
COOKIE_SECURE=true

# 是否用 IP 归属地辅助判断登录环境是否变化 (默认: true)
GEO_ENABLED=true

# 地理比对粒度: province | city | off (默认: province)
# 市级噪声较大（移动基站在相邻城市间漂移），一般不需要改
GEO_SCOPE=province

# ===== 路径配置 =====

# 日志目录 (默认: logs)
LOG_DIR=logs

# ===== 文件分享 =====
# 单文件上限、服务端总容量、条目上限与分片大小（字节）。
# 默认值适合 1 核 1G 的小机器；调大前先确认磁盘与月流量。
PABU_TRANSFER_MAX_FILE=67108864
PABU_TRANSFER_MAX_TOTAL=268435456
PABU_TRANSFER_MAX_ENTRIES=50
PABU_TRANSFER_CHUNK_SIZE=4194304


