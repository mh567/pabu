# Pabu 服务器配置
# 复制此文件为 .env 并根据需要修改

# ===== 服务器配置 =====
# 监听地址 (默认: 127.0.0.1，仅本地访问)
# 设置为 0.0.0.0 允许外部访问
SERVER_HOST=127.0.0.1

# 监听端口 (默认: 4001)
SERVER_PORT=4001

# ===== HTTPS 配置 (可选) =====
# 是否启用 HTTPS (true/false)
HTTPS_ENABLED=false

# SSL/TLS 证书路径 (HTTPS_ENABLED=true 时必填)
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=
HTTPS_CA_PATH=

# ===== 安全配置 =====
# 管理员密码文件路径 (默认: .admin-password.json)
ADMIN_PASSWORD_FILE=.admin-password.json

# 登录 Cookie 的 Secure 标记由服务端自动判断：请求经 https 到达才加，
# 纯 http 部署自动省略。无需修改本项，仅在需要覆盖自动判断时改动。
COOKIE_SECURE=true

# 是否用 IP 归属地辅助判断登录环境是否变化 (默认: true)
GEO_ENABLED=true

# 地理比对粒度: province | city | off (默认: province)
# 市级噪声较大（移动基站在相邻城市间漂移），一般不需要改
GEO_SCOPE=province

# ===== 路径配置 =====

# 日志目录 (默认: logs)
LOG_DIR=logs

# ===== 文件分享 =====
# 单文件上限、服务端总容量、条目上限与分片大小（字节）。
# 默认值适合 1 核 1G 的小机器；调大前先确认磁盘与月流量。
PABU_TRANSFER_MAX_FILE=67108864
PABU_TRANSFER_MAX_TOTAL=268435456
PABU_TRANSFER_MAX_ENTRIES=50
PABU_TRANSFER_CHUNK_SIZE=4194304

# ===== 实时传文件（WebRTC 直连）=====
# 服务端只做 5 位码配对与信令，不保存文件内容。
# 实时单文件上限（字节，默认 256 MiB）。接收端在内存中重组分片，
# 调大前先确认接收设备内存。
PABU_RTC_MAX_FILE=268435456
# 等待配对过期时间与配对后活动续期窗口（毫秒）。活动会话在每次
# 信令或轮询时滑动续期。
PABU_RTC_WAITING_TTL=600000
PABU_RTC_ACTIVE_TTL=3600000
# 长轮询单次挂起上限（毫秒）。
PABU_RTC_POLL_TIMEOUT=20000
# STUN/TURN 列表，JSON 数组或字符串数组。默认使用公共 STUN；
# 自建 TURN 时只填写 urls，凭据由下面的密钥动态生成。留空使用默认值。
# PABU_RTC_ICE_SERVERS=["stun:stun.example.com:3478","turn:turn.example.com:3478"]
# TURN 短期凭据密钥，对应 coturn 的 use-auth-secret / static-auth-secret。
# 配置了 TURN 地址但没有这个密钥时，TURN 地址会被跳过。
# PABU_RTC_TURN_SECRET=
# TURN 凭据有效期（秒，默认 600）。
# PABU_RTC_TURN_TTL=600

# ===== 网站图标抓取 =====
# 第三方 favicon 回退默认关闭。仅在明确接受向供应商发送公开站点 origin 时启用。
# 支持 google,duckduckgo，逗号分隔。不会发送书签路径、查询参数或 fragment。
# PABU_ICON_FALLBACK_PROVIDERS=google,duckduckgo
